import BaseLayout from "../layouts/BaseLayout.astro";
import Timeline from "../components/Timeline.astro";
---

<BaseLayout>
  <!-- Toegevoegd: een container met een hoofdgedeelte (main) -->
  <main class="container">
    
    <h1>Gevolgen van huurachterstand</h1>

    <p class="hero-intro">
      Hoe langer een huurachterstand blijft bestaan,
      hoe groter de kans op extra kosten en juridische
      maatregelen.
    </p>

    <Timeline />

  </main>
</BaseLayout>