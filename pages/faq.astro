---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>

<section class="container">

  <h1>Veelgestelde vragen</h1>

  <div class="cards">

    <article>
      <h3>Kan ik uit huis worden gezet?</h3>
      <p>
        Alleen na een uitspraak van de rechter.
      </p>
    </article>

    <article>
      <h3>Wat moet ik doen bij een huurachterstand?</h3>
      <p>
        Neem zo snel mogelijk contact op met uw verhuurder,
        en maak uw huurachterstand bespreekbaar
      </p>
    </article>

    <article>
      <h3>Heb ik recht op hulp?</h3>
      <p>
        Ja, via de gemeente, schuldhulpverlening of huurtoeslag.
      </p>
    </article>

    <article>
      <h3>Moet ik mijn post openen?</h3>
      <p>
        Ja. Belangrijke informatie staat vaak in brieven van uw verhuurder.
      </p>
    </article>

  </div>

</section>

</BaseLayout>
