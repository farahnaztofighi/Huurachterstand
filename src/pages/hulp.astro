---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>

<section class="container">

  <h1>Hulp en ondersteuning</h1>

  <p>
    Heeft u moeite met het betalen van uw huur? Er zijn verschillende
    organisaties die u kunnen helpen.
  </p>

  <div class="cards">

    <a
      href="https://www.rijksoverheid.nl/vraag-en-antwoord/schulden/schuldhulpverlening-aanvragen"
      target="_blank"
      class="card-link"
    >
      <article>
        <h3>Schuldhulpverlening</h3>
        <p>
          Hulp bij schulden en financieel overzicht.
        </p>
      </article>
    </a>

    <a
      href="https://budgetcoach.nl/"
      target="_blank"
      class="card-link"
    >
      <article>
        <h3>Budgetcoach</h3>
        <p>
          Samen inzicht krijgen in inkomsten en uitgaven.
        </p>
      </article>
    </a>

    <a
      href="https://www.belastingdienst.nl/wps/wcm/connect/nl/huurtoeslag/huurtoeslag"
      target="_blank"
      class="card-link"
    >
      <article>
        <h3>Huurtoeslag</h3>
        <p>
          Mogelijk heeft u recht op financiële ondersteuning.
        </p>
      </article>
    </a>

    <a
      href="https://www.juridischloket.nl/schulden-en-incasso/schulden-oplossen/schuldhulpverlening-gemeente/"
      target="_blank"
      class="card-link"
    >
      <article>
        <h3>Gemeentelijke hulp</h3>
        <p>
          Bekijk welke ondersteuning uw gemeente kan bieden.
        </p>
      </article>
    </a>

  </div>

</section>

</BaseLayout>
